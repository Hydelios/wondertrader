{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 调试 STP 项目",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/project/stp/build/test_stp_debug",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/project/stp",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/project/stp/libs:${workspaceFolder}/project/stp:${workspaceFolder}/src/build_all/build_x64/Release/bin:$LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "编译 STP 项目",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "trace": false,
                "engineLogging": false,
                "programOutput": true,
                "exceptions": true
            }
        },
