{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SIPUI - test_parser_zc",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/project/sipui/bin/test_parser_zc",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/project/sipui",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/project/sipui/libs:${workspaceFolder}/3rd/mydeps_gcc8.4.0/lib:$LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build SIPUI Debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true,
                "programOutput": true,
                "trace": true,
                "traceResponse": true
            },
            "sourceFileMap": {
                "/root/trading_sys/wondertrader": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug SIPUI - test_parser_zc (No Build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/project/sipui/bin/test_parser_zc",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/project/sipui",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/project/sipui/libs:${workspaceFolder}/3rd/mydeps_gcc8.4.0/lib:$LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false,
                "programOutput": true,
                "trace": false
            },
            "sourceFileMap": {
                "/root/trading_sys/wondertrader": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug SIPUI - Attach to Process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/project/sipui/bin/test_parser_zc",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
