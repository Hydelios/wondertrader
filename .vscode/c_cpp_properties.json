{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/Includes",
                "${workspaceFolder}/src/Share",
                "${workspaceFolder}/src/API/sipsi2Api/inc",
                "${workspaceFolder}/src/ParserZC",
                "${workspaceFolder}/3rd/mydeps_gcc8.4.0/include",
                "${workspaceFolder}/3rd/mydeps_gcc8.4.0/include/boost",
                "${workspaceFolder}/project/sipui/src",
                "/usr/include",
                "/usr/local/include",
                "/usr/include/c++/9",
                "/usr/include/x86_64-linux-gnu/c++/9"
            ],
            "defines": [
                "_DEBUG",
                "DEBUG",
                "UNICODE",
                "_UNICODE",
                "__linux__",
                "__x86_64__"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/project/sipui/build/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/project/sipui",
                    "${workspaceFolder}/3rd/mydeps_gcc8.4.0/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            }
        }
    ]
}
