{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SIPUI Debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd build && cmake -DCMAKE_BUILD_TYPE=Debug .. && make -j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project/sipui"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean SIPUI Build",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "*"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project/sipui/build"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Build SIPUI Release",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd build && cmake -DCMAKE_BUILD_TYPE=Release .. && make -j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project/sipui"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run SIPUI Test",
            "type": "shell",
            "command": "./bin/test_parser_zc",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/project/sipui"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": false,
                "clear": true
            },
            "dependsOn": "Build SIPUI Debug"
        }
    ]
}
